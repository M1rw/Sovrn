# =============================================================================
# SOVRN Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=production
DEBUG=false
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Domain & URLs
# -----------------------------------------------------------------------------
DOMAIN=localhost
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sovrn
POSTGRES_USER=sovrn
POSTGRES_PASSWORD=change_me_in_production_use_strong_password

# Connection string (auto-constructed in docker, override if needed)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Supabase (optional managed backend)
# -----------------------------------------------------------------------------
# Set SUPABASE_ENABLED=true when running against hosted Supabase.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct Postgres URL for Supabase branch/prod database.
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# Redis (optional - for caching, can use in-memory if not available)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# AI Inference (llama.cpp)
# -----------------------------------------------------------------------------
INFERENCE_HOST=infer
INFERENCE_PORT=8080
INFERENCE_URL=http://${INFERENCE_HOST}:${INFERENCE_PORT}

# Model configuration
MODEL_PATH=/models/llama-3.2-11b-q4_k_m.gguf
MODEL_CONTEXT_SIZE=4096
MODEL_THREADS=4
MODEL_GPU_LAYERS=0

# -----------------------------------------------------------------------------
# Multi-Agent Orchestration (AQE)
# -----------------------------------------------------------------------------
ORCHESTRATION_RUNTIME_ENABLED=true
ORCHESTRATION_AQE_ENABLED=true
ORCHESTRATION_AQE_INFERENCE_STATS_TIMEOUT_SECONDS=2
ORCHESTRATION_REQUEST_TIME_BUDGET_SECONDS=180
ORCHESTRATION_STAGE_TIMEOUT_SECONDS=45
ORCHESTRATION_CRITIC_MAX_ATTEMPTS=2
ORCHESTRATION_CRITIC_STRICT_FAIL=false

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Session secret for Next.js
NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_hex_32
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Sparks (Monetization)
# -----------------------------------------------------------------------------
# Default spark allocations per plan
SPARKS_FREE=3
SPARKS_FREELANCER=30
SPARKS_BUSINESS=100
SPARKS_AGENCY=-1

# Cost per generation (in sparks)
SPARK_COST_BASIC=1
SPARK_COST_ADVANCED=3
SPARK_COST_PREMIUM=5

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_GENERATIONS_PER_HOUR=10

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
ARTIFACTS_PATH=/var/artifacts
MAX_ARTIFACT_SIZE_MB=100
ARTIFACT_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Email (optional - for notifications)
# -----------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=/backups

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------
# Enable hot reload in development
HOT_RELOAD=false

# Enable debug endpoints
DEBUG_ENDPOINTS=false

# Seed database with test data
SEED_DATABASE=false
