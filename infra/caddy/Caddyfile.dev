# =============================================================================
# SOVRN Caddyfile - Development Configuration
# =============================================================================

{
    # Disable HTTPS in development
    auto_https off
    admin off
}

:80 {
    # API routes
    handle /api/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # WebSocket
    handle /ws/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    # Health check
    handle /health {
        respond "OK" 200
    }

    # Frontend
    handle {
        reverse_proxy web:3000 {
            header_up Host {host}
        }
    }

    log {
        output stdout
        format console
    }
}
